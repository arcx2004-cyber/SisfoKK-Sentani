---
import '../styles/global.css';

import { fetchMenus, fetchSettings } from '../lib/api';

interface Props {
  title: string;
  description?: string;
}

const settings = await fetchSettings();
const { title, description = settings.school_motto || 'Sekolah Kristen Kalam Kudus Sentani - Dengan Kasih & Disiplin Meningkatkan Prestasi' } = Astro.props;

// Fetch menus from API
const fetchedMenus = await fetchMenus();
const menuItems = fetchedMenus.length > 0 ? fetchedMenus.map(m => ({
  name: m.nama,
  href: m.url
})) : [
  { name: 'Home', href: '/' },
  { name: 'Profile', href: '/profile' },
  { name: 'Visi Misi', href: '/visi-misi' },
  { name: 'Unit', href: '/unit' },
  { name: 'Galeri', href: '/galeri' },
  { name: 'Kegiatan', href: '/kegiatan' },
  { name: 'Kontak', href: '/kontak' },
  { name: 'Berita', href: '/berita' },
  { name: 'PPDB', href: '/ppdb' },
];

const loginUrl = import.meta.env.PUBLIC_ADMIN_URL || 'https://skkksentani.web.id/admin';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline></script>
    <title>{title} | SisfoKK Sentani</title>
  </head>
  <body class="bg-gray-50 text-gray-900 overflow-x-hidden">
    <!-- Header -->
    <header class="header fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="mainHeader">
      <div class="container py-4">
        <nav class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-3 no-underline group">
            <div class="relative w-12 h-12 flex items-center justify-center bg-white rounded-xl shadow-sm transition-transform group-hover:scale-105">
                <img src="/logo.png" alt="Logo Kalam Kudus" class="w-10 h-10 object-contain" />
            </div>
            <div class="flex flex-col">
              <span class="font-heading font-extrabold text-xl leading-tight text-white">{settings.school_short_name || 'Kalam Kudus'} <span class="text-primary-300">Sentani</span></span>
              <span class="text-[10px] uppercase tracking-widest text-white/70 font-medium">Faith · Hope · Love</span>
            </div>
          </a>
          
          <ul class="hidden lg:flex items-center gap-1 list-none bg-white/10 backdrop-blur-md p-1.5 rounded-full border border-white/20">
            {menuItems.map(item => (
              <li>
                <a href={item.href} class="px-4 py-2 rounded-full text-sm font-semibold text-white no-underline transition-all hover:bg-white hover:text-primary-700">{item.name}</a>
              </li>
            ))}
          </ul>

          <div class="hidden lg:flex items-center gap-4">
            <a href={loginUrl} class="px-5 py-2.5 rounded-full bg-white text-primary-700 text-sm font-bold no-underline shadow-lg shadow-black/5 hover:bg-primary-50 transition-colors">Portal Login</a>
          </div>

          <button class="lg:hidden p-2 text-white bg-white/10 rounded-xl backdrop-blur-md border border-white/20" id="mobileMenuBtn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="24" height="24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile Menu -->
      <div class="hidden absolute top-full left-0 right-0 bg-primary-900/95 backdrop-blur-xl border-t border-white/10 shadow-2xl overflow-hidden transition-all duration-300 transform origin-top scale-y-0" id="mobileMenu">
        <div class="container py-8 flex flex-col gap-6">
          <ul class="flex flex-col gap-2 list-none p-0 m-0">
            {menuItems.map(item => (
              <li>
                <a href={item.href} class="block px-4 py-3 rounded-xl text-lg font-semibold text-white no-underline hover:bg-white/10">{item.name}</a>
              </li>
            ))}
          </ul>
          <a href={loginUrl} class="w-full text-center py-4 rounded-xl bg-white text-primary-900 font-bold no-underline shadow-xl">Portal Login</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="pt-[var(--header-height)]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 pt-20 pb-10 text-gray-400">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          <div class="flex flex-col gap-6">
            <a href="/" class="flex items-center gap-3 no-underline">
                <div class="w-12 h-12 flex items-center justify-center bg-white rounded-xl">
                    <img src="/logo.png" alt="Logo Kalam Kudus" class="w-10 h-10 object-contain" />
                </div>
                <div class="flex flex-col">
                  <span class="font-heading font-extrabold text-xl leading-tight text-white">SisfoKK <span class="text-primary-500">Sentani</span></span>
                </div>
            </a>
            <p class="text-sm leading-relaxed italic text-gray-500">"{settings.school_motto || 'Dengan Kasih & Disiplin Meningkatkan Prestasi'}"</p>
            <div class="flex gap-4">
                <!-- Social placeholder icons would go here -->
            </div>
          </div>

          <div>
            <h4 class="text-white font-heading font-bold mb-6 text-lg">Menu Utama</h4>
            <ul class="flex flex-col gap-3 list-none p-0">
              <li><a href="/" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Beranda</a></li>
              <li><a href="/profile" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Profil Sekolah</a></li>
              <li><a href="/visi-misi" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Visi & Misi</a></li>
              <li><a href="/unit" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Unit Pendidikan</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-white font-heading font-bold mb-6 text-lg">Informasi</h4>
            <ul class="flex flex-col gap-3 list-none p-0">
              <li><a href="/berita" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Berita Terkini</a></li>
              <li><a href="/galeri" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Galeri Foto</a></li>
              <li><a href="/kegiatan" class="text-gray-400 hover:text-white transition-colors no-underline text-sm uppercase tracking-wider font-semibold">Kegiatan Kami</a></li>
              <li><a href="/ppdb" class="text-primary-400 hover:text-primary-300 transition-colors no-underline text-sm uppercase tracking-wider font-bold">Pendaftaran (PPDB)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-white font-heading font-bold mb-6 text-lg">Kontak</h4>
            <div class="flex flex-col gap-4 text-sm">
                <div class="flex gap-3">
                    <span class="text-primary-500">📍</span>
                    <span>{settings.school_address || 'Jl. Raya Sentani, Jayapura, Papua'}</span>
                </div>
                <div class="flex gap-3">
                    <span class="text-primary-500">📞</span>
                    <span>{settings.school_phone || '(0967) 123456'}</span>
                </div>
                <div class="flex gap-3">
                    <span class="text-primary-500">✉️</span>
                    <span>{settings.school_email || 'info@sisfokk.sch.id'}</span>
                </div>
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium uppercase tracking-[2px]">
          <p>&copy; {new Date().getFullYear()} {settings.school_name || 'SisfoKK Sentani'}.</p>
          <div class="flex gap-6">
              <a href="#" class="text-gray-600 hover:text-gray-400 no-underline transition-colors">Privacy Policy</a>
              <a href="#" class="text-gray-600 hover:text-gray-400 no-underline transition-colors">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      const header = document.getElementById('mainHeader');
      const mobileMenuBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      // Scroll effect
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
            header.style.backgroundColor = 'rgba(12, 74, 110, 0.9)';
            header.style.backdropFilter = 'blur(16px)';
            header.style.boxShadow = '0 10px 15px -3px rgb(0 0 0 / 0.1)';
        } else {
            header.style.backgroundColor = 'transparent';
            header.style.backdropFilter = 'none';
            header.style.boxShadow = 'none';
        }
      });

      // Mobile menu toggle
      mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        if (!mobileMenu?.classList.contains('hidden')) {
            mobileMenu.style.display = 'block';
            setTimeout(() => {
                mobileMenu.style.transform = 'scaleY(1)';
            }, 10);
        } else {
            mobileMenu.style.transform = 'scaleY(0)';
            setTimeout(() => {
                mobileMenu.style.display = 'none';
            }, 300);
        }
      });
    </script>

    <style is:global>
        .header {
            height: var(--header-height);
            display: flex;
            align-items: center;
            background: linear-gradient(180deg, rgba(8, 47, 73, 0.8) 0%, rgba(8, 47, 73, 0) 100%);
        }
    </style>
  </body>
</html>
