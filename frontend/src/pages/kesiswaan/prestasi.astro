---
import Layout from '../../layouts/Layout.astro';
import { fetchPrestasiPaginated, formatDate, getImageUrl } from '../../lib/api';

const res = await fetchPrestasiPaginated(50);
const prestasis = Array.isArray(res) ? res : [];
---

<Layout title="Prestasi Siswa">
  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 min-h-screen py-10">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-2">Prestasi Siswa</h1>
        <p class="text-gray-600">Kebanggaan Sekolah Kristen Kalam Kudus Sentani</p>
      </div>

      {prestasis.length === 0 ? (
        <div class="text-center bg-white p-10 rounded-lg shadow-sm max-w-2xl mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <p class="text-gray-500 text-lg">Belum ada data prestasi yang ditampilkan.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {prestasis.map((item) => (
            <div class="bg-white rounded-xl shadow-lg overflow-hidden transform hover:-translate-y-1 transition duration-300">
              <div class="relative h-56 bg-gray-200">
                 <img 
                  src={getImageUrl(item.foto, '/placeholder-prestasi.jpg')} 
                  alt={item.judul}
                  class="w-full h-full object-cover"
                  onerror="this.src='https://placehold.co/600x400?text=Prestasi+Siswa'"
                />
                <div class="absolute top-0 right-0 m-4">
                    <span class="bg-yellow-400 text-yellow-900 text-xs font-bold px-3 py-1 rounded-full shadow-md uppercase tracking-wide">
                        {item.jenis}
                    </span>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center text-xs text-gray-500 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    {formatDate(item.tanggal)}
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2 leading-tight">{item.judul}</h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-3">{item.keterangan}</p>
                
                <div class="flex items-center pt-4 border-t border-gray-100">
                    <div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center text-white text-xs font-bold mr-3">
                        {item.siswa?.nama_lengkap?.charAt(0) || 'S'}
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-800">{item.siswa?.nama_lengkap || 'Siswa'}</p>
                        {item.siswa?.unit && (
                             <p class="text-xs text-gray-500">{item.siswa.unit.nama}</p>
                        )}
                    </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
